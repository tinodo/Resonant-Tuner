<Page
    x:Class="Resonant.App.Views.TunerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Resonant.Core.Localization"
    xmlns:controls="using:Resonant.App.Controls"
    xmlns:vm="using:Resonant.App.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid x:Name="LayoutRoot" Padding="24,12,24,16" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Calibration.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="12,8,12,12" />
                        <Setter Target="LayoutRoot.RowSpacing" Value="8" />
                        <Setter Target="Calibration.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="QuietInput">
                    <VisualState.StateTriggers><StateTrigger IsActive="{x:Bind ViewModel.IsInputQuiet, Mode=OneWay}" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="InputLevel.Foreground" Value="{ThemeResource ResonantAccentBrush}" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NormalInput">
                    <VisualState.StateTriggers><StateTrigger IsActive="{x:Bind ViewModel.IsInputNormal, Mode=OneWay}" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="InputLevel.Foreground" Value="{ThemeResource ResonantInputGoodBrush}" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HighInput">
                    <VisualState.StateTriggers><StateTrigger IsActive="{x:Bind ViewModel.IsInputHigh, Mode=OneWay}" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="InputLevel.Foreground" Value="{ThemeResource ResonantAccentBrush}" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ClippingInput">
                    <VisualState.StateTriggers><StateTrigger IsActive="{x:Bind ViewModel.IsInputClipping, Mode=OneWay}" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="InputLevel.Foreground" Value="{ThemeResource ResonantInputClipBrush}" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="RetainedPitch">
                    <VisualState.StateTriggers><StateTrigger IsActive="{x:Bind ViewModel.IsPitchStale, Mode=OneWay}" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PitchReadout.Opacity" Value="0.6" />
                        <Setter Target="CentsReadout.Opacity" Value="0.6" />
                        <Setter Target="NoteReadout.Foreground" Value="{ThemeResource ResonantMutedBrush}" />
                        <Setter Target="FrequencyReadout.Foreground" Value="{ThemeResource ResonantMutedBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PresetBox" HorizontalAlignment="Left" MaxWidth="300"
                      ItemsSource="{x:Bind ViewModel.Presets}" DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.IsPresetEnabled, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind loc:Text.Get('Instrument tuning')}" />
            <TextBlock x:Name="Calibration" Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                       Text="{x:Bind ViewModel.CalibrationText, Mode=OneWay}"
                       Style="{StaticResource ResonantMutedStyle}" />
            <Button Grid.Column="2" Width="40" Height="36" ToolTipService.ToolTip="{x:Bind loc:Text.Get('Tuning options')}"
                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('Tuning options')}">
                <FontIcon Glyph="&#xE713;" FontSize="18" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="240" Spacing="16">
                            <ToggleSwitch Header="{x:Bind loc:Text.Get('Chromatic')}" OnContent="{x:Bind loc:Text.Get('On')}" OffContent="{x:Bind loc:Text.Get('Off')}"
                                          IsOn="{x:Bind ViewModel.IsChromatic, Mode=TwoWay}" />
                            <ToggleSwitch Header="{x:Bind loc:Text.Get('Auto string')}" OnContent="{x:Bind loc:Text.Get('On')}" OffContent="{x:Bind loc:Text.Get('Locked')}"
                                          IsOn="{x:Bind ViewModel.AutoString, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.IsPresetEnabled, Mode=OneWay}" />
                            <ToggleSwitch Header="{x:Bind loc:Text.Get('Spectrum')}" OnContent="{x:Bind loc:Text.Get('On')}" OffContent="{x:Bind loc:Text.Get('Off')}"
                                          IsOn="{x:Bind ViewModel.ShowSpectrum, Mode=TwoWay}" />
                            <NumberBox Header="{x:Bind loc:Text.Get('Capo')}" HorizontalAlignment="Left" Width="130" Minimum="0" Maximum="12" SmallChange="1"
                                       SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CapoValue, Mode=TwoWay}"
                                               IsEnabled="{x:Bind ViewModel.IsCapoEnabled, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CalibrationText, Mode=OneWay}"
                                       Style="{StaticResource ResonantMutedStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind loc:Text.Get('Retry')}" Command="{x:Bind ViewModel.RetryCommand}"
                            Visibility="{x:Bind ViewModel.RetryVisibility, Mode=OneWay}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <HyperlinkButton Content="{x:Bind loc:Text.Get('Microphone settings')}" Command="{x:Bind ViewModel.OpenMicrophoneSettingsCommand}"
                                     Visibility="{x:Bind ViewModel.PermissionHelpVisibility, Mode=OneWay}" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar IsOpen="{x:Bind ViewModel.IsOutputMessageOpen, Mode=OneWay}" Severity="Error"
                     Message="{x:Bind ViewModel.OutputMessage, Mode=OneWay}" IsClosable="False" />
        </StackPanel>
        <Grid Grid.Row="2" RowSpacing="8" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:SpectrumBackground x:Name="Spectrum" Margin="4,20,4,8"
                                             Visibility="{x:Bind ViewModel.SpectrumVisibility, Mode=OneWay}" />
                <Viewbox Stretch="Uniform" MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid Width="520" Height="440">
                        <controls:PitchMeter x:Name="Meter" Cents="{x:Bind ViewModel.MeterCents, Mode=OneWay}"
                                             IsLocked="{x:Bind ViewModel.IsLocked, Mode=OneWay}"
                                             IsStale="{x:Bind ViewModel.IsPitchStale, Mode=OneWay}" />
                        <StackPanel x:Name="PitchReadout" VerticalAlignment="Top" Margin="0,228,0,0" Spacing="0" IsHitTestVisible="False"
                                    Visibility="{x:Bind ViewModel.PitchReadoutVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="NoteReadout" Text="{x:Bind ViewModel.NoteName, Mode=OneWay}" FontFamily="Bahnschrift"
                                           FontSize="78" Foreground="{ThemeResource ResonantTextBrush}"
                                           AutomationProperties.Name="{x:Bind loc:Text.Get('Detected note')}" />
                                <TextBlock Text="{x:Bind ViewModel.OctaveText, Mode=OneWay}" FontSize="26"
                                           VerticalAlignment="Center" Foreground="{ThemeResource ResonantMutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="FrequencyReadout" Text="{x:Bind ViewModel.MeasuredText, Mode=OneWay}" FontFamily="Bahnschrift"
                                       FontSize="24" HorizontalAlignment="Center" Foreground="{ThemeResource ResonantPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
                <Grid Grid.Row="1" Height="64">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="{x:Bind ViewModel.CorrectionGlyph, Mode=OneWay}" FontSize="16"
                                  Foreground="{ThemeResource ResonantAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.CorrectionText, Mode=OneWay}" FontSize="16"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                   Foreground="{ThemeResource ResonantAccentBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="CentsReadout" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6"
                                Visibility="{x:Bind ViewModel.PitchReadoutVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.CentsText, Mode=OneWay}" FontSize="20" FontFamily="Bahnschrift"
                                   Foreground="{ThemeResource ResonantTextBrush}" />
                        <TextBlock Text="{x:Bind loc:Text.Get('cents')}" VerticalAlignment="Center" Foreground="{ThemeResource ResonantMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Grid>
        <GridView x:Name="StringsGrid" Grid.Row="1" Height="80" ItemsSource="{x:Bind ViewModel.Strings}"
                  Visibility="{x:Bind ViewModel.StringsVisibility, Mode=OneWay}" SelectionMode="None"
                  IsItemClickEnabled="False" HorizontalAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="{x:Bind loc:Text.Get('String targets')}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="MinWidth" Value="48" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:StringItemViewModel">
                    <Grid Width="48" Height="64">
                        <Rectangle Width="1" Height="52" Fill="{ThemeResource ResonantBorderBrush}" />
                        <ToggleButton Width="48" Height="40" Padding="0" VerticalAlignment="Center"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                      IsChecked="{x:Bind IsLocked, Mode=OneWay}"
                                      Checked="OnStringToggled" Unchecked="OnStringToggled"
                                      AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                      AutomationProperties.HelpText="{x:Bind ActionText, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind ActionText, Mode=OneWay}">
                                <Grid>
                                <Border Background="{ThemeResource ResonantRaisedBrush}" CornerRadius="6"
                                    BorderBrush="{ThemeResource ResonantBorderBrush}" BorderThickness="1" />
                                <Border CornerRadius="6" BorderBrush="{ThemeResource ResonantPrimaryBrush}" BorderThickness="1"
                                    Visibility="{x:Bind TrackingVisibility, Mode=OneWay}" />
                                <Border Background="{ThemeResource ResonantPrimaryBrush}" CornerRadius="6"
                                    Visibility="{x:Bind LockedVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind NoteText}" FontSize="20" FontFamily="Bahnschrift"
                                           TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                           LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Visibility="{x:Bind UnlockedVisibility, Mode=OneWay}"
                                           Foreground="{ThemeResource ResonantTextBrush}" />
                                <TextBlock Text="{x:Bind NoteText}" FontSize="20" FontFamily="Bahnschrift"
                                       TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Visibility="{x:Bind LockedVisibility, Mode=OneWay}"
                                       Foreground="{ThemeResource ResonantOnPrimaryBrush}" />
                                </Grid>
                        </ToggleButton>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        </Grid>
        <Grid Grid.Row="3" BorderBrush="{ThemeResource ResonantBorderBrush}" BorderThickness="0,1,0,0"
              Padding="0,12,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" RowSpacing="4" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="InputLevel" Grid.ColumnSpan="2" Maximum="100" Value="{x:Bind ViewModel.Level, Mode=OneWay}"
                             Foreground="{ThemeResource ResonantMutedBrush}"
                             AutomationProperties.Name="{x:Bind loc:Text.Get('Microphone input level')}"
                             AutomationProperties.HelpText="{x:Bind ViewModel.InputLevelDescription, Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind ViewModel.InputLevelDescription, Mode=OneWay}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{x:Bind loc:Text.Get('Target')}" FontSize="12" Foreground="{ThemeResource ResonantMutedBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TargetText, Mode=OneWay}" FontSize="12"
                               Foreground="{ThemeResource ResonantMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                           Text="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource ResonantMutedBrush}"
                           ToolTipService.ToolTip="{x:Bind loc:Text.Get('Pitch confidence')}" AutomationProperties.HelpText="{x:Bind loc:Text.Get('Pitch confidence')}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <ToggleButton Width="40" Height="40" Command="{x:Bind ViewModel.PlayReferenceCommand}"
                          Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          IsChecked="{x:Bind ViewModel.IsReferencePlaying, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.ReferenceButtonText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.ReferenceButtonText, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.ReferenceGlyph, Mode=OneWay}" FontSize="20" />
            </ToggleButton>
                <Button Width="28" Height="40" Padding="0"
                        AutomationProperties.AutomationId="OutputDeviceMenu"
                        AutomationProperties.Name="{x:Bind loc:Text.Get('Reference output')}"
                        ToolTipService.ToolTip="{x:Bind loc:Text.Get('Reference output')}">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="OutputDevicesFlyout" Opening="OnDeviceMenuOpening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <ToggleButton Width="88" Height="40" Command="{x:Bind ViewModel.ToggleCaptureCommand}"
                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    IsChecked="{x:Bind ViewModel.IsListeningRequested, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.StartStopText, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.StartStopText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind ViewModel.CaptureGlyph, Mode=OneWay}" FontSize="18" />
                    <TextBlock Text="{x:Bind ViewModel.CaptureButtonText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
                <Button Width="28" Height="40" Padding="0"
                        AutomationProperties.AutomationId="InputDeviceMenu"
                        AutomationProperties.Name="{x:Bind loc:Text.Get('Input device')}"
                        ToolTipService.ToolTip="{x:Bind loc:Text.Get('Input device')}">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="InputDevicesFlyout" Opening="OnDeviceMenuOpening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
