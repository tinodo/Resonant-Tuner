<UserControl
    x:Class="Resonant.App.Controls.SpectrumBackground"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Resonant.Core.Localization"
    IsHitTestVisible="False"
    AutomationProperties.Name="{x:Bind loc:Text.Get('Live microphone spectrum, 40 Hz to 12 kHz')}"
    AutomationProperties.AutomationId="LiveSpectrum">
        <Grid>
            <Canvas x:Name="Plot" Opacity="0">
        <Path x:Name="FrequencyGrid" Stroke="{ThemeResource ResonantBorderBrush}" StrokeThickness="0.5" Opacity="0.3" />
          <Path x:Name="SpectrumFill" Fill="{ThemeResource ResonantSpectrumFillBrush}"
              Stroke="{ThemeResource ResonantPrimaryBrush}" StrokeThickness="1.5" Opacity="0.65" />
        <Path x:Name="PeakLine" Stroke="{ThemeResource ResonantSecondaryBrush}" StrokeThickness="1" Opacity="0.45" />
        <TextBlock x:Name="LowLabel" Text="40 Hz" FontSize="10" Foreground="{ThemeResource ResonantMutedBrush}" Opacity="0.5" />
        <TextBlock x:Name="MidLabel" Text="1 kHz" FontSize="10" Foreground="{ThemeResource ResonantMutedBrush}" Opacity="0.5" />
        <TextBlock x:Name="HighLabel" Text="12 kHz" FontSize="10" Foreground="{ThemeResource ResonantMutedBrush}" Opacity="0.5" />
            </Canvas>
            <Canvas x:Name="IdealPlot" Visibility="Collapsed">
                <Path x:Name="IdealLine" Stroke="{ThemeResource ResonantAccentBrush}" StrokeThickness="2"
                      StrokeLineJoin="Round" Opacity="0.9" />
            </Canvas>
        </Grid>
</UserControl>