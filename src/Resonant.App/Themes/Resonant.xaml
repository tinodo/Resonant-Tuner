<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- Dark is the instrument-canvas default. -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ResonantSurfaceBrush" Color="#0C1116" />
            <SolidColorBrush x:Key="ResonantRaisedBrush" Color="#141D24" />
            <SolidColorBrush x:Key="ResonantSunkenBrush" Color="#090E12" />
            <SolidColorBrush x:Key="ResonantTextBrush" Color="#F0F5F3" />
            <SolidColorBrush x:Key="ResonantMutedBrush" Color="#A6B5B8" />
            <SolidColorBrush x:Key="ResonantBorderBrush" Color="#33444C" />
            <SolidColorBrush x:Key="ResonantPrimaryBrush" Color="#58E4F4" />
            <LinearGradientBrush x:Key="ResonantSpectrumFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.34">
                <GradientStop Offset="0" Color="#58E4F4" />
                <GradientStop Offset="1" Color="#0058E4F4" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ResonantSecondaryBrush" Color="#EE83D3" />
            <SolidColorBrush x:Key="ResonantOnPrimaryBrush" Color="#09291F" />
            <SolidColorBrush x:Key="ResonantAccentBrush" Color="#F3E687" />
            <SolidColorBrush x:Key="ResonantInputGoodBrush" Color="#75D99D" />
            <SolidColorBrush x:Key="ResonantInputClipBrush" Color="#FF8989" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ResonantSurfaceBrush" Color="#F3F7F5" />
            <SolidColorBrush x:Key="ResonantRaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ResonantSunkenBrush" Color="#E8EFEC" />
            <SolidColorBrush x:Key="ResonantTextBrush" Color="#10201A" />
            <SolidColorBrush x:Key="ResonantMutedBrush" Color="#4A5E58" />
            <SolidColorBrush x:Key="ResonantBorderBrush" Color="#BFCDC8" />
            <SolidColorBrush x:Key="ResonantPrimaryBrush" Color="#0A6F54" />
            <LinearGradientBrush x:Key="ResonantSpectrumFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.34">
                <GradientStop Offset="0" Color="#0A6F54" />
                <GradientStop Offset="1" Color="#000A6F54" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ResonantSecondaryBrush" Color="#A62785" />
            <SolidColorBrush x:Key="ResonantOnPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ResonantAccentBrush" Color="#8F5400" />
            <SolidColorBrush x:Key="ResonantInputGoodBrush" Color="#166B38" />
            <SolidColorBrush x:Key="ResonantInputClipBrush" Color="#B42318" />
        </ResourceDictionary>

        <!-- Windows Contrast themes: system colours only. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ResonantSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ResonantRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ResonantSunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ResonantTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ResonantMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ResonantBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ResonantPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ResonantSpectrumFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ResonantSecondaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ResonantOnPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ResonantAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ResonantInputGoodBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ResonantInputClipBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="ResonantPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ResonantRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ResonantBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="ResonantInstrumentStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ResonantSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ResonantBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="28,24,28,20" />
    </Style>

    <Style x:Key="ResonantEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource ResonantMutedBrush}" />
    </Style>

    <Style x:Key="ResonantHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource ResonantTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ResonantSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource ResonantTextBrush}" />
    </Style>

    <Style x:Key="ResonantMutedStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ResonantMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ResonantNumericStyle" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{ThemeResource ResonantTextBrush}" />
    </Style>

</ResourceDictionary>
