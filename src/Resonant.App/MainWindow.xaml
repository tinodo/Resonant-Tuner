<Window
    x:Class="Resonant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Resonant.Core.Localization"
    Title="resonant tuner">

    <Grid x:Name="Root" Background="{ThemeResource ResonantSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="140" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragTitleBar" Padding="16,0,0,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8D6;" FontSize="17" Foreground="{ThemeResource ResonantPrimaryBrush}" />
                    <TextBlock Text="resonant tuner" FontFamily="Bahnschrift" FontSize="16"
                               Foreground="{ThemeResource ResonantTextBrush}" />
                </StackPanel>
            </Grid>
            <Button x:Name="CompactButton" Grid.Column="1" Width="40" Height="32" Padding="0"
                    VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnToggleCompact">
                <FontIcon x:Name="CompactIcon" Glyph="&#xE73F;" FontSize="16" />
            </Button>
        </Grid>
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        Background="Transparent"
                        SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="TunerNavItem" Tag="tuner">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TuningsNavItem" Tag="tunings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
